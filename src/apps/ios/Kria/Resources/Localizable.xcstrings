          }
        }
      }
    },
    "The server rejected this request. Edit it and review the current source or script before generating again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Der Server hat diese Anfrage abgelehnt. Bearbeite sie und prüf die aktuelle Quelle oder das Skript, bevor du erneut erstellst."
          }
