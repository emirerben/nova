          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Seçmek için çift dokun, sonra bir klipla doldur"
          }
        }
      }
    },
    "Double tap to select, then use Add here. Press and hold, then drag, to place it on the song." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Doppeltippen zum Auswählen, dann Hier hinzufügen nutzen. Gedrückt halten und ziehen, um ihn auf dem Song zu platzieren."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Seçmek için çift dokun, sonra Buraya ekle’yi kullan. Şarkıya yerleştirmek için basılı tutup sürükle."
          }
        }
      }
    },
    "Double tap to select. Swipe up or down to move by half a second. Drag to move it anywhere on the song." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Doppeltippen zum Auswählen. Nach oben oder unten wischen, um es um eine halbe Sekunde zu verschieben. Ziehen, um es an eine beliebige Stelle im Song zu setzen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Seçmek için çift dokun. Yarım saniye kaydırmak için yukarı veya aşağı kaydır. Şarkının herhangi bir yerine taşımak için sürükle."
          }
        }
      }
    },
    "Draft" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
