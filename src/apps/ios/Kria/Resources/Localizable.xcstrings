    "Kria asked us to pause checking this plan. Your update remains saved." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kria hat darum gebeten, die Prüfung dieses Plans zu pausieren. Dein Update bleibt gespeichert."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kria bu planın kontrolünü duraklatmamızı istedi. Güncellemen kayıtlı kalıyor."
          }
        }
      }
    },
    "Kria can learn from this idea’s words when it writes future ideas for you. You can erase it any time with Forget editorial taste." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kria kann aus den Worten dieser Idee lernen, wenn sie künftig Ideen für dich schreibt. Du kannst das jederzeit mit „Redaktionellen Geschmack vergessen“ löschen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kria, senin için gelecekte fikir yazarken bu fikrin sözcüklerinden öğrenebilir. İstediğin zaman “Editoryal zevki unut” ile silebilirsin."
          }
        }
      }
    },
    "Kria can learn from your version when it writes future ideas for you. You can erase it any time with Forget editorial taste." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kria kann aus deiner Version lernen, wenn sie künftig Ideen für dich schreibt. Du kannst das jederzeit mit „Redaktionellen Geschmack vergessen“ löschen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kria, senin için gelecekte fikir yazarken senin versiyonundan öğrenebilir. İstediğin zaman “Editoryal zevki unut” ile silebilirsin."
          }
        }
      }
    },
    "Kria can only see the %lld items you shared. Everything else stays private." : {
      "localizations" : {
        "de" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "needs_review",
                  "value" : "Kria sieht nur das %lld Element, das du geteilt hast. Alles andere bleibt privat."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "needs_review",
                  "value" : "Kria sieht nur die %lld Elemente, die du geteilt hast. Alles andere bleibt privat."
                }
              }
            }
          }
        },
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
