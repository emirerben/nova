    "Change its fonts, placement, color or effects. “From All text” means it follows your All text choice." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ändere Schriften, Platzierung, Farbe oder Effekte. „Aus ‚Alle Texte‘“ heißt, es folgt deiner Auswahl bei „Alle Texte“."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Yazı tiplerini, konumunu, rengini veya efektlerini değiştir. “Tüm yazılar’dan” ifadesi, Tüm yazılar seçimini izlediği anlamına gelir."
          }
        }
      }
    },
