          }
        }
      }
    },
    "Your messages and selected media, including faces, voices, and transcripts, are sent to Google Gemini and OpenAI for analysis, transcription, and editing. Kria stores your projects and finished videos in your account." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Deine Nachrichten und ausgewählten Medien, einschließlich Gesichtern, Stimmen und Transkripten, werden zur Analyse, Transkription und Bearbeitung an Google Gemini und OpenAI gesendet. Kria speichert deine Projekte und fertigen Videos in deinem Konto."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mesajların ve seçtiğin medyalar (yüzler, sesler ve metin dökümleri dahil) analiz, yazıya dökme ve düzenleme için Google Gemini ve OpenAI'a gönderilir. Kria projelerini ve tamamlanan videolarını hesabında saklar."
          }
        }
      }
    },
    "Your microphone didn’t record anything. Record again with the mic uncovered." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
