        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kria kayıtlı içerikleri gelecekteki fikirler için örnek olarak kullanır."
          }
        }
      }
    },
    "Kria wasn’t sure where %lld clips fit in your song. Tap a clip to watch it, then drag or use the arrows to fix the order." : {
