    },
    "The source changed or is unavailable. Your edits are still here." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Die Quelle hat sich geändert oder ist nicht verfügbar. Deine Änderungen sind noch da."
