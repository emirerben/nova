        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kria panondakini kullanamıyor. Bir yazı ya da resim kopyala ve tekrar dene."
          }
        }
      }
    },
    "Kria centres your media in the frame." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
