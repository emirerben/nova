    "1080 × 1920 · 30 fps recipe · 6 seconds. Use the player controls to scrub. Export timings and errors are saved on this device." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "1080 × 1920 · 30-fps-Rezept · 6 Sekunden. Nutze die Player-Steuerung zum Scrubben. Export-Zeiten und Fehler werden auf diesem Gerät gespeichert."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "1080 × 1920 · 30 fps tarif · 6 saniye. Gezinmek için oynatıcı kontrollerini kullan. Dışa aktarma süreleri ve hatalar bu cihazda kaydedilir."
          }
        }
      }
    },
