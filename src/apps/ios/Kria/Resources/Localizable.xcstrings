          }
        }
      }
    },
    "Only this topic is searched. Your clips and direction stay private." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nur dieses Thema wird gesucht. Deine Clips und deine Richtung bleiben privat."
