{
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "target": "es2017",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"],
      "@nova/motion-runtime": ["../../packages/motion-runtime/src/index.ts"],
      "@nova/motion-runtime/canvaskit": ["../../packages/motion-runtime/src/canvaskit.ts"],
      "@nova/motion-runtime/schema": ["../../packages/motion-runtime/motion-scene.schema.json"],
      "@nova/motion-runtime/catalog": ["../../packages/motion-runtime/creator-blocks.catalog.json"],
      "@nova/motion-runtime/ai-catalog": ["../../packages/motion-runtime/src/ai-catalog.ts"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules", "e2e", "playwright.config.ts"]
}
