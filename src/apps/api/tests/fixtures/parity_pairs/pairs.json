{
  "schema_version": 1,
  "ticket": "KRI-773",
  "layer": "phase 2 layer 2: model-level English/Turkish decision parity",
  "notes": [
    "One pair = one creator decision asked once in English and once in natural Turkish (not a word-for-word translation).",
    "Everything except the creator's message is identical across the two languages (same base input, same footage context), so a different decision is caused by the message language.",
    "`reply_language` is set from app.kria.reply_language.detect_chat_language(message) for agents that take it, as production does for a chat in that language.",
    "`compare` says which structured fields of the parsed output carry the decision; titles typed in each language are compared by presence, verbatim titles (same string in both) by value.",
    "`expect` is the intended decision (a subset of the projection). A pair where both languages miss `expect` is an English gap, not a parity gap.",
    "`base_fixture` is relative to tests/fixtures/agent_evals/; `base_input` deep-merges over the fixture input (or is the whole input when there is no fixture)."
  ],
  "agents": {
    "brief_extractor": {
      "class": "app.agents.brief_extractor:BriefExtractorAgent",
      "message_fields": [
        "user_message"
      ],
      "reply_language": false
    },
    "main_creator": {
      "class": "app.agents.main_creator:MainCreatorAgent",
      "message_fields": [
        "user_message"
      ],
      "reply_language": true
    },
    "edit_copilot": {
      "class": "app.agents.edit_copilot:EditCopilotAgent",
      "message_fields": [
        "utterance"
      ],
      "reply_language": true
    },
    "clip_intent_planner": {
      "class": "app.agents.clip_intent_planner:ClipIntentPlannerAgent",
      "message_fields": [
        "creator_request",
        "latest_user_message"
      ],
      "reply_language": true
    },
    "creator_memory_extractor": {
      "class": "app.agents.creator_memory_extractor:CreatorMemoryExtractorAgent",
      "message_fields": [
        "source_message"
      ],
      "reply_language": false
    },
    "slide_post_composer": {
      "class": "app.agents.slide_post_composer:SlidePostComposerAgent",
      "message_fields": [
        "notes"
      ],
      "reply_language": false
    }
  },
