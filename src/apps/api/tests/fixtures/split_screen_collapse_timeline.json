    {
      "name": "two_panels_top_ends_first",
      "note": "The bottom panel takes the whole canvas once the top panel ends; the section lasts until the bottom ends.",
      "slots": [
        {
          "slot_id": "top",
          "clip_index": 0,
          "in_s": 0,
          "duration_s": 2,
          "split_section_id": "duo",
          "split_panel_index": 0,
          "split_offset_s": 0
        },
        {
          "slot_id": "bottom",
          "clip_index": 1,
          "in_s": 0,
          "duration_s": 4,
          "split_section_id": "duo",
          "split_panel_index": 1,
          "split_offset_s": 0
        }
      ],
      "split_screen_sections": [
        {
          "id": "duo",
          "duration_s": 4,
          "panel_count": 2,
          "panel_weights": [
            1,
            1
          ],
          "gutter": 0,
          "background_color": "#000000",
          "collapse_empty_panels": true
        }
      ],
      "expected_duration_s": 4,
      "expected_windows": [
        {
          "slot_id": "top",
          "start_s": 0,
          "end_s": 2
        },
        {
          "slot_id": "bottom",
          "start_s": 0,
          "end_s": 4
        }
      ],
      "expected_recipe_sections": [
        {
          "id": "duo",
          "start": 0,
          "end": 4
        }
      ],
      "canvas_samples": [
