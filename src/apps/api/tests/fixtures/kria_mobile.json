{
  "endpoints": {
    "/auth/mobile/exchange": {
      "method": "POST",
      "request": "MobileExchangeRequest",
      "response": "MobileSessionOut"
    },
    "/auth/mobile/link": {
      "method": "POST",
      "request": "MobileExchangeRequest",
      "response": "MobileLinkResponse"
    },
    "/auth/mobile/me": {
      "method": "GET",
      "response": "MobileUserOut"
    },
    "/auth/mobile/refresh": {
      "method": "POST",
      "request": "MobileRefreshRequest",
      "response": "MobileSessionOut"
    },
    "/auth/mobile/reviewer-login": {
      "method": "POST",
      "request": "MobileReviewerLoginRequest",
      "response": "MobileSessionOut"
    },
    "/auth/mobile/revoke": {
      "method": "POST",
      "request": "MobileRefreshRequest",
      "response": "MobileRevokeResponse"
    },
    "/plan-items/{item_id}/variants/{variant_id}/editor-sources": {
      "method": "POST",
      "request": "EditorSourceRequest",
      "response": "EditorSourceOut",
      "success_statuses": [
        200,
        202
      ]
    },
    "/plan-items/{item_id}/variants/{variant_id}/editor-sources/{import_id}": {
      "method": "GET",
      "response": "EditorSourceOut"
    }
  },
  "models": {
    "EditRecipeV1": {
      "assets": "Array<MediaAsset>",
      "audio": "AudioMixRecipe",
      "canvas": "Canvas",
      "frame_rate": "number",
      "renderer_version": "string",
      "required_capabilities": "Set<MediaCapability>",
      "schema_version": 1,
      "tracks": "Array<TimelineTrack>"
    },
    "EditorSourceOut": {
      "error": [
        "string",
        "null"
      ],
      "import_id": "UUID",
      "reason_code": [
        "string",
        "null"
      ],
      "retryable": "boolean",
      "source": [
        "GuidedEditorSource",
        "null"
      ],
      "source_id": "string",
      "source_index": [
        "integer",
        "null"
      ],
      "status": [
        "preparing",
        "ready",
        "failed"
      ]
    },
    "EditorSourceRequest": {
      "base_generation": "string",
      "client_import_id": "UUID",
      "guided_revision_number": "integer",
      "source_id": "string",
      "source_kind": [
        "footage",
        "visual"
      ]
    },
    "GuidedEditorSource": {
      "duration_s": [
        "number",
        "null"
      ],
      "gcs_path": "string",
      "generation": "string",
      "kind": [
        "image",
        "video"
      ],
      "lane": [
        "clip",
        "asset"
      ],
      "media_id": "string"
    },
    "MobileExchangeRequest": {
      "id_token": "string",
      "nonce": "string",
      "provider": [
        "google",
        "apple"
      ]
    },
    "MobileLinkResponse": {
      "linked": "boolean",
      "linked_providers": "Array<Provider>"
    },
    "MobileRefreshRequest": {
      "refresh_token": "string"
    },
    "MobileReviewerLoginRequest": {
      "email": "string",
      "password": "string"
    },
    "MobileRevokeResponse": {
      "revoked": "boolean"
    },
    "MobileSessionOut": {
      "access_token": "string",
      "expires_in": "integer",
      "refresh_token": "string",
      "token_type": "Bearer",
      "user": "MobileUserOut"
    },
    "MobileUserOut": {
      "email": "string",
      "id": "string",
      "linked_providers": "Array<Provider>",
      "name": [
        "string",
        "null"
      ],
      "onboarding_status": "string"
    }
  },
  "schema_version": 1
}
