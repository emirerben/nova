    "KriaProblemOut": {
      "$defs": {
        "KriaProblem": {
          "additionalProperties": false,
          "properties": {
            "code": {
              "pattern": "^[a-z][a-z0-9_]{2,79}$",
              "title": "Code",
              "type": "string"
            },
            "current_revision": {
              "anyOf": [
                {
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Current Revision"
            },
            "message": {
              "title": "Message",
              "type": "string"
            },
            "phase": {
              "enum": [
                "accept",
                "plan",
                "policy",
                "tool",
                "approval",
                "dispatch",
                "observe"
              ],
              "title": "Phase",
              "type": "string"
            },
            "recovery": {
              "default": "none",
              "enum": [
                "retry",
                "refresh_replan",
                "ask_user",
                "manual",
                "none"
              ],
              "title": "Recovery",
              "type": "string"
            },
            "retryable": {
              "default": false,
              "title": "Retryable",
              "type": "boolean"
            },
            "target": {
              "additionalProperties": {
                "type": "string"
              },
              "title": "Target",
              "type": "object"
            },
            "trace_id": {
              "title": "Trace Id",
              "type": "string"
            }
          },
          "required": [
            "code",
            "phase",
            "message",
            "trace_id"
          ],
          "title": "KriaProblem",
          "type": "object"
        }
      },
      "properties": {
        "problem": {
          "$ref": "#/$defs/KriaProblem"
        }
      },
      "required": [
        "problem"
      ],
      "title": "KriaProblemOut",
      "type": "object"
    },
    "SubmitTurnBody": {
