  "schema_version": 2,
  "tools": [
    {
      "argument_schema": {
        "additionalProperties": false,
        "description": "Portable EditCopilot operations; target and generation pins are server-owned.",
        "properties": {
          "operations": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "maxItems": 8,
            "minItems": 1,
            "title": "Operations",
            "type": "array"
          },
          "summary": {
            "maxLength": 1000,
            "minLength": 1,
            "title": "Summary",
            "type": "string"
          }
        },
        "required": [
          "operations",
          "summary"
        ],
        "title": "ApplyEditorOpsArguments",
        "type": "object"
      },
      "capability": "editor_operations",
      "description": "Apply a validated reversible operation bundle to the authoritative editor draft.",
      "execution_mode": "sync",
      "failure_class": "editor_draft_apply_failed",
      "name": "draft.apply_editor_ops",
      "result_schema": {
        "additionalProperties": false,
        "properties": {
          "changes": {
            "items": {
              "type": "string"
            },
            "title": "Changes",
            "type": "array"
          },
          "draft_id": {
            "title": "Draft Id",
            "type": "string"
          },
          "draft_revision": {
            "minimum": 0,
            "title": "Draft Revision",
            "type": "integer"
          },
          "snapshot_hash": {
            "title": "Snapshot Hash",
            "type": "string"
          }
        },
        "required": [
          "draft_id",
          "draft_revision",
          "snapshot_hash",
          "changes"
        ],
        "title": "ApplyStrategyResult",
        "type": "object"
      },
      "retry": "idempotent",
      "risk": "reversible_draft",
      "version": 1
    },
    {
      "argument_schema": {
        "$defs": {
          "ContextLabelIntent": {
            "additionalProperties": false,
            "description": "Bounded intent for a trusted pipeline-resolved contextual label.\n\nThis carries no label text. Clip metadata is descriptive evidence and must\nbe resolved and confirmed by the trusted render pipeline before rendering.",
            "properties": {
              "kind": {
                "const": "sport",
                "default": "sport",
                "title": "Kind",
                "type": "string"
              },
              "per_clip": {
                "default": true,
                "title": "Per Clip",
                "type": "boolean"
              },
              "placement": {
                "const": "bottom_right",
                "default": "bottom_right",
                "title": "Placement",
                "type": "string"
              },
              "size": {
                "const": "small",
                "default": "small",
                "title": "Size",
                "type": "string"
              },
              "source": {
                "default": "clip_metadata",
                "enum": [
                  "clip_metadata",
                  "user_provided"
                ],
                "title": "Source",
                "type": "string"
              }
            },
            "title": "ContextLabelIntent",
            "type": "object"
          },
          "CreativeStrategy": {
            "additionalProperties": false,
            "description": "Bounded editorial choices selected by the orchestrator.\n\n``intro_hook`` remains an advisory concept for backwards compatibility.\n``opening_title`` is the separate, confirmed copy contract: when present it\nis burned verbatim (after the renderer's normal surrounding trim), rather\nthan being sent back through an LLM.  The optional typography fields use\nthe same font/color vocabulary as the authoritative TextElement schema.",
            "properties": {
              "archetype": {
                "anyOf": [
                  {
                    "enum": [
                      "montage",
                      "talking_head",
                      "day_vlog",
                      "single_hero",
                      "subtitled",
                      "narrated",
                      "narrated_planned",
                      "narrated_ready",
                      "slides"
                    ],
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Archetype"
              },
              "audio_strategy": {
                "default": "licensed_music",
                "enum": [
                  "licensed_music",
                  "original_audio",
                  "voiceover"
                ],
                "title": "Audio Strategy",
                "type": "string"
              },
              "caption_style": {
                "default": "auto",
                "enum": [
                  "none",
                  "clean",
                  "kinetic",
                  "karaoke",
                  "editorial",
                  "auto"
                ],
                "title": "Caption Style",
                "type": "string"
              },
              "context_label": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/ContextLabelIntent"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Confirmed request for a server-resolved contextual label; this carries no model-authored label text."
              },
              "direction": {
                "default": "fast_montage",
                "enum": [
                  "guided_story",
                  "fast_montage",
                  "text_explainer",
                  "native"
                ],
                "title": "Direction",
                "type": "string"
              },
              "edit_format": {
                "default": "montage",
                "enum": [
                  "montage",
                  "talking_head",
                  "day_vlog",
                  "single_hero",
                  "subtitled",
                  "narrated",
                  "narrated_planned",
                  "narrated_ready",
                  "slides"
                ],
                "title": "Edit Format",
                "type": "string"
              },
              "execution_contract": {
                "anyOf": [
                  {
                    "const": "guided_voiceover_v1",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Execution Contract"
              },
              "font_family": {
                "anyOf": [
                  {
                    "maxLength": 160,
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Confirmed intro font registry key.",
                "title": "Font Family"
              },
              "image_layout": {
                "anyOf": [
                  {
                    "enum": [
                      "fullscreen",
                      "supporting_card"
                    ],
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Confirmed image-only layout. supporting_card shows the full image; fullscreen fills the canvas with a cover crop.",
                "title": "Image Layout"
              },
              "intro_hook": {
                "anyOf": [
                  {
                    "maxLength": 280,
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Opening concept shown for creative approval; never treated as trusted or burned verbatim by the renderer",
                "title": "Intro Hook"
              },
              "licensed_sfx": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/LicensedSfxIntent"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null
              },
              "media_scope": {
                "anyOf": [
                  {
                    "enum": [
                      "all",
                      "selected"
                    ],
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Media Scope"
              },
              "mixed_media_timing": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/MixedMediaTimingProfile"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null
              },
              "montage_audio": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/MontageAudioPlan"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null
              },
              "montage_cadence": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/MontageCadenceConstraint"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null
              },
              "opening_title": {
                "anyOf": [
                  {
                    "maxLength": 280,
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Confirmed exact opening title copy; never an LLM-generated suggestion.",
                "title": "Opening Title"
              },
              "optional_treatments": {
                "items": {
                  "enum": [
                    "overlays",
                    "sfx",
                    "transitions",
                    "looks"
                  ],
                  "type": "string"
                },
                "maxItems": 4,
                "title": "Optional Treatments",
                "type": "array"
              },
              "pacing": {
                "default": "balanced",
                "enum": [
                  "relaxed",
                  "balanced",
                  "fast"
                ],
                "title": "Pacing",
                "type": "string"
              },
              "participant_labels": {
                "default": "none",
                "enum": [
                  "none",
                  "single_subject"
                ],
                "title": "Participant Labels",
                "type": "string"
              },
              "rationale": {
                "default": "",
                "maxLength": 2000,
                "title": "Rationale",
                "type": "string"
              },
              "render_program": {
                "default": "guided",
                "enum": [
                  "guided",
                  "native"
                ],
                "title": "Render Program",
                "type": "string"
              },
              "score_labels": {
                "default": false,
                "title": "Score Labels",
                "type": "boolean"
              },
              "selected_media_ids": {
                "items": {
                  "type": "string"
                },
                "maxItems": 50,
                "title": "Selected Media Ids",
                "type": "array"
              },
              "sport_labels": {
                "default": false,
                "title": "Sport Labels",
                "type": "boolean"
              },
              "story_structure": {
                "items": {
                  "type": "string"
                },
                "maxItems": 8,
                "title": "Story Structure",
                "type": "array"
              },
              "target_duration_s": {
                "default": 24,
                "maximum": 60,
                "minimum": 3,
                "title": "Target Duration S",
                "type": "number"
              },
              "text_color": {
                "anyOf": [
                  {
                    "maxLength": 16,
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Confirmed intro color (#RRGGBB or a supported color alias).",
                "title": "Text Color"
              },
