        "src/apps/ios/Kria/Core/Editor*.swift",
        "src/apps/ios/Tests/KriaUITests/EditorUITests.swift",
        "src/apps/ios/Tests/KriaUITests/NativeEditorInspectorUITests.swift",
        "src/apps/ios/Tests/KriaUITests/DrawingJourneyUITests.swift"
      ],
      "tests": [
        "EditorUITests/testNativeEditorTrimHandleShortensExtendsAndUndoesAsOneGesture",
        "EditorUITests/testNativeEditorLongTextEditPreservesDurationAndClipGeometry",
        "DrawingJourneyUITests/testDrawDoneTrimSaveReopenPersists",
        "EditorUITests/testCapturedCreationWordsPlayReopenAndExport"
      ]
    },
    {
      "id": "slides",
      "paths": [
        "src/apps/ios/Kria/Core/SlidePost*.swift",
        "src/apps/ios/Kria/Features/SlidePost*.swift",
        "src/apps/ios/Tests/KriaUITests/SlidePostUITests.swift"
      ],
      "tests": [
        "SlidePostUITests/testSlidePostCreationIsTheRichLayoutThenCreateThenKriaPropose",
        "SlidePostUITests/testRichLayoutFromTheDrawerWhenCapabilitiesFailToLoad",
        "SlidePostUITests/testRichLayoutFromTheGalleryForEveryCapabilityState",
        "SlidePostUITests/testSizeSheetSquareFitAllReshapesThePreviewAndSurvivesSave"
      ]
    }
