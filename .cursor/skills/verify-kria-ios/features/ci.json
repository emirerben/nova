        "src/apps/ios/Kria/Features/Project*.swift",
        "src/apps/ios/Kria/Features/Library*.swift",
        "src/apps/ios/Tests/KriaUITests/ProjectsUITests.swift"
      ],
      "tests": [
        "CreationUITests/testLaunchEntersChatFirstWorkspace",
        "ProjectsUITests/testProjectActionsCanBeCancelledWithoutChangingProject",
        "ProjectsUITests/testRenameValidatesNameAndRetainsInputAfterFailedSaveAndRetry"
      ]
    },
    {
      "id": "creation",
      "paths": [
        "src/apps/ios/Kria/Core/Creation*.swift",
        "src/apps/ios/Kria/Features/Creation*.swift",
        "src/apps/ios/Kria/Features/Upload*.swift",
        "src/apps/ios/Kria/Features/Song*.swift",
        "src/apps/ios/Tests/KriaUITests/CreationUITests.swift",
        "src/apps/ios/Tests/KriaUITests/AttachmentFlowUITests.swift"
      ],
      "tests": [
        "CreationUITests/testCreationWithAttachedFootageReachesConfirmationAndReadyForBothRuntimes",
        "CreationUITests/testGalleryPickIsReadFromPhotosAndReachesUpload",
        "CreationUITests/testLibraryPickerReturnsToChatByDoneAndBySinglePick",
        "AttachmentFlowUITests/testNarratedAttachmentsSwipeAndRequireExplicitAudioChoice"
      ]
    },
    {
      "id": "teleprompter",
      "paths": [
        "src/apps/ios/Kria/Features/Teleprompter*.swift",
        "src/apps/ios/Tests/KriaUITests/TeleprompterUITests.swift"
      ],
      "tests": [
        "TeleprompterUITests/testScriptIsSavedAndCameraFailureKeepsItEditable"
      ]
