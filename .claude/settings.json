{
  "permissions": {
    "deny": ["Read(./src/apps/web/src/**)"]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          { "type": "command", "command": "bash scripts/session-check.sh" },
          { "type": "command", "command": "f=\"$CLAUDE_PROJECT_DIR/scripts/hooks/ci-triage-nudge.py\"; [ -f \"$f\" ] || exit 0; exec python3 \"$f\" --session-start", "timeout": 20 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "f=\"$CLAUDE_PROJECT_DIR/scripts/hooks/merge-guard.py\"; [ -f \"$f\" ] || exit 0; exec python3 \"$f\"", "timeout": 45 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "bash scripts/hooks/format-on-save.sh" }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "f=\"$CLAUDE_PROJECT_DIR/scripts/hooks/ci-triage-nudge.py\"; [ -f \"$f\" ] || exit 0; exec python3 \"$f\"", "timeout": 15 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "bash scripts/hooks/agent-runs.sh start claude" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "bash scripts/hooks/agent-runs.sh finish claude" }
        ]
      }
    ]
  }
}
