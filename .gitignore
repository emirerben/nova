# Secrets — never commit
.env
.env.*
!.env.example
!.env.local-render.example

# Video files — never commit (large, contain user content)
*.mp4 *.mov *.mkv *.avi *.webm *.hevc *.m4v *.3gp *.heic
*.d.ts.map
raw_uploads/
processed_outputs/
tmp/

# Dev environment runtime state (dev-auto.sh logs + PIDs)
.dev/

# Local-render outputs (downloaded MP4s from `make local-render`)
.local-render/

# Pre-PR overlay-verify outputs (reports + montages from `make verify-overlays`)
.overlay-verify/

# Python
__pycache__/
.venv/
.venv
.ruff_cache/
*.pyc *.pyo
dist/
*.egg-info/

# Node / Next.js
node_modules/
node_modules
.next/
.turbo/
out/
*.tsbuildinfo
.derived-data/
src/apps/ios/.derived-data/
src/apps/ios/.device-derived/
src/apps/ios/.build/
src/apps/ios/**/.build/
src/apps/ios/Kria.xcodeproj/

# OS
.DS_Store
.gstack/

# Firebase
firebase-debug.log
.devtest/

# Weekly TikTok research raw dumps (intermediate, reproducible — not committed).
research/tiktok/raw/

# gbrain per-worktree pin (machine-local, not shared)
.gbrain-source
.cluster-e2e/
playwright-report/
test-results/

# Test virtualenv (separate dir from .venv/, shared across worktrees)
.venv-test/
.venv-test

# gbrain local source caches / mirrors (machine-local; rebuilt by gbrain sync)
.sources/

# Supabase CLI local link state
supabase/.temp/

# Local Claude settings backups
.claude/settings.local.json.bak*

# Vercel CLI local cache
.vercel
# Developer-specific iOS API/OAuth overrides.
src/apps/ios/Config/Local.xcconfig
src/apps/ios/Packages/*/.swiftpm/

# CI test timing artifacts
/test-results/
