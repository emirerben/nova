    classDef degraded fill:#fef5e7,stroke:#b9770e,stroke-width:2px,color:#6e2c00
    classDef failed fill:#f4f6f7,stroke:#566573,color:#1b2631

    class Opening,Saving,PreviewPending,OnDevice,Rebasing working
    class Clean,Dirty,ExitDialog,RenderNotStarted,RenderFailed,DeviceRetry,Conflict,SaveFailed,NewerJobPrompt,PreviewTimeout,RefreshFailed yourturn
    class SavedEmpty,Ready done
    class LostOnKill,PreviewNeverMatches,ConflictLoop,OldJobLoop stuck
