    [*] --> dispatch
    dispatch --> cloudRendering : Cloud render
    dispatch --> awaitingDevice : Phone render
    dispatch --> failedCard : Start refused

    cloudRendering --> ready : All versions done
    cloudRendering --> cloudPartial : Some versions failed
    cloudPartial --> ready : Watch the good ones
    cloudRendering --> failedCard : Render failed

    awaitingDevice --> phonePreparing : iPhone picks up the job
    awaitingDevice --> ghostPreparing : Capabilities never loaded
    ghostPreparing --> timedOut : 24h pass
    ghostPreparing --> awaitingDevice : Leave and reopen the project
    awaitingDevice --> cantRenderHere : iPhone says use cloud
    cantRenderHere --> cantRenderHere : Tap Try again
    cantRenderHere --> timedOut : 24h pass
    awaitingDevice --> superseded : Newer edit approved
    phonePreparing --> phoneRendering : Footage ready
    phonePreparing --> needsAttention : Prep failed
    phoneRendering --> localReady : Export finished
    phoneRendering --> needsAttention : Export, storage or heat
    phoneRendering --> structural : Style not supported
    phonePreparing --> stopped : Tap Stop rendering
    phoneRendering --> stopped : Tap Stop rendering
    stopped --> stoppedServerWaits : Server missed the stop
    stoppedServerWaits --> timedOut : 24h pass
    stopped --> retryApproval : Tap Try again
    localReady --> syncing : Upload starts
    syncing --> synced : Upload accepted
    syncing --> localReady : Upload failed, Retry sync
    synced --> ready
    needsAttention --> retryApproval : Tap Try again
    timedOut --> retryApproval : Tap Try again
    structural --> [*] : Start a new chat
    retryApproval --> awaitingDevice : You approve again

    failedCard --> retryApproval : Retry approved edit
    failedCard --> refreshLoop : No retry id, tap Refresh
    refreshLoop --> refreshLoop : Tap Refresh again
    refreshLoop --> [*] : Type a new message
    failedCard --> nonRetryable : Phone gate refusal
    nonRetryable --> [*] : New chat
    ready --> [*]

