default_platform(:ios)

platform :ios do
  desc("Upload the already-signed Kria IPA and distribute it to external TestFlight testers")
  lane :testflight do
    marketing_version = ENV.fetch("KRIA_MARKETING_VERSION")
    build_number = ENV.fetch("KRIA_BUILD_NUMBER").to_i
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_CONNECT_API_KEY_BASE64"),
      is_key_content_base64: true,
    )

    latest_build = app_store_build_number(
      api_key: api_key,
      version: marketing_version,
      live: false,
      initial_build_number: 0,
    ).to_i

    if latest_build >= build_number
      UI.important("TestFlight already has build #{latest_build} for #{marketing_version}; skipping duplicate upload #{build_number}.")
    else
      upload_to_testflight(
        api_key: api_key,
        ipa: ENV.fetch("KRIA_IPA_PATH"),
        skip_waiting_for_build_processing: false,
        distribute_external: true,
        groups: [ENV.fetch("KRIA_TESTFLIGHT_GROUP")],
        notify_external_testers: true,
        app_version: marketing_version,
        build_number: build_number,
        demo_account_required: false,
        changelog: "Kria build #{build_number} from #{ENV.fetch("GITHUB_SHA")}",
        beta_app_description: ENV.fetch("KRIA_BETA_APP_DESCRIPTION"),
        beta_app_feedback_email: ENV.fetch("KRIA_BETA_FEEDBACK_EMAIL"),
        beta_app_review_info: {
          contact_email: ENV.fetch("KRIA_BETA_REVIEW_CONTACT_EMAIL"),
          contact_first_name: ENV.fetch("KRIA_BETA_REVIEW_CONTACT_FIRST_NAME"),
          contact_last_name: ENV.fetch("KRIA_BETA_REVIEW_CONTACT_LAST_NAME"),
          contact_phone: ENV.fetch("KRIA_BETA_REVIEW_CONTACT_PHONE"),
          notes: ENV.fetch("KRIA_BETA_REVIEW_NOTES"),
        },
      )
    end
  end
end
